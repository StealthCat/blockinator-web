# Blockinator bootstrap configuration
# Bootstrap credentials are read only when the database has no administrator/API keys.
# After first startup, manage both from Access & Security in the web UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
POLICY_API_KEY=change-this-long-random-api-key

# Database backend: sqlite (default) or mysql.
# Backend selection is read at startup; restart Blockinator after changing it.
DATABASE_BACKEND=sqlite

# SQLite uses DATA_DIR/policy.db and requires no additional settings.
# MySQL settings are only used when DATABASE_BACKEND=mysql.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=blockinator
MYSQL_USER=blockinator
MYSQL_PASSWORD=
MYSQL_CONNECT_TIMEOUT=10
MYSQL_POOL_SIZE=10
MYSQL_POOL_TIMEOUT_SECONDS=5
MYSQL_POOL_RECYCLE_SECONDS=300

# Optional MySQL TLS. Set MYSQL_SSL_ENABLED=1 to request TLS.
# For private CAs or mutual TLS, mount the certificate files into the
# Blockinator container and provide their in-container paths below.
MYSQL_SSL_ENABLED=0
MYSQL_SSL_CA=
MYSQL_SSL_CERT=
MYSQL_SSL_KEY=
MYSQL_SSL_VERIFY_CERT=1


POLICY_PORT=8080
# Host port for HTTPS. Set to 443 for standard HTTPS.
HTTPS_PORT=8443
MAX_BLOCKLIST_BYTES=104857600

# Background scheduler scan frequency. Each URL list still uses its own refresh interval.
BLOCKLIST_REFRESH_POLL_SECONDS=30
# Concurrent URL downloads/parses; database commits remain serialized.
BLOCKLIST_REFRESH_WORKERS=4

# Set to 1 when the web UI is only served over HTTPS (directly or through a reverse proxy).
ADMIN_COOKIE_SECURE=0

# Optional: administrator login session lifetime in seconds (default 12 hours).
ADMIN_SESSION_TTL_SECONDS=43200

# Reverse DNS display for client addresses.
# Leave RDNS_NAMESERVERS blank to use the container's normal DNS configuration.
# Or provide comma-separated DNS server IPs, e.g. 192.168.1.2,192.168.1.3
RDNS_NAMESERVERS=
RDNS_TIMEOUT_SECONDS=0.5
RDNS_PAGE_BUDGET_SECONDS=1.25
RDNS_CACHE_TTL_SECONDS=300
RDNS_NEGATIVE_TTL_SECONDS=60
RDNS_WORKERS=12

# Durable PTR resolver that runs in parallel with policy decisions.
# Resolved names are refreshed daily; authoritative no-PTR results are
# rechecked every six hours. Transient failures use exponential backoff.
RDNS_RESOLVER_WORKERS=8
RDNS_RESOLVED_REFRESH_SECONDS=86400
RDNS_NO_PTR_REFRESH_SECONDS=21600
RDNS_RECONCILE_SECONDS=1

# Bootstrap default schedule timezone. After first startup, manage this from System Settings.
# Existing schedules keep their individually saved timezone.
TZ=UTC

# Caddy/TLS reconciliation interval. Blockinator reapplies saved TLS config after a Caddy restart.
TLS_RECONCILE_SECONDS=30
