# Blockinator bootstrap configuration
# Bootstrap credentials are read only when the database has no administrator/API keys.
# After first startup, manage both from Access & Security in the web UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
POLICY_API_KEY=change-this-long-random-api-key

POLICY_PORT=8080
MAX_BLOCKLIST_BYTES=104857600

# Set to 1 when the web UI is only served over HTTPS (directly or through a reverse proxy).
ADMIN_COOKIE_SECURE=0

# Optional: administrator login session lifetime in seconds (default 12 hours).
ADMIN_SESSION_TTL_SECONDS=43200
