# Blockinator bootstrap configuration
# Bootstrap credentials are read only when the database has no administrator/API keys.
# After first startup, manage both from Access & Security in the web UI.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
POLICY_API_KEY=change-this-long-random-api-key

POLICY_PORT=8080
MAX_BLOCKLIST_BYTES=104857600

# Set to 1 when the web UI is only served over HTTPS (directly or through a reverse proxy).
ADMIN_COOKIE_SECURE=0

# Optional: administrator login session lifetime in seconds (default 12 hours).
ADMIN_SESSION_TTL_SECONDS=43200

# Reverse DNS display for client addresses.
# Leave RDNS_NAMESERVERS blank to use the container's normal DNS configuration.
# Or provide comma-separated DNS server IPs, e.g. 192.168.1.2,192.168.1.3
RDNS_NAMESERVERS=
RDNS_TIMEOUT_SECONDS=0.5
RDNS_PAGE_BUDGET_SECONDS=1.25
RDNS_CACHE_TTL_SECONDS=300
RDNS_NEGATIVE_TTL_SECONDS=60

# Bootstrap default schedule timezone. After first startup, manage this from System Settings.
# Existing schedules keep their individually saved timezone.
TZ=UTC
